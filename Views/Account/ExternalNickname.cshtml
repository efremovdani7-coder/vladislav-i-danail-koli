@model ExternalNicknameViewModel
@{
    ViewData["Title"] = "Изберете никнейм";
}

<div class="row justify-content-center">
    <div class="col-md-7 col-lg-5">
        <div class="card border-0 shadow">
            <div class="card-body p-4">
                <h2 class="mb-2">Още една стъпка</h2>
                <p class="text-body-secondary">Влязохте с <strong>@Model.Provider</strong>@(string.IsNullOrEmpty(Model.Email) ? "" : $" ({Model.Email})"). Изберете никнейм, с който ще ви виждат другите потребители.</p>
                <form asp-action="ExternalNickname" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                    <input type="hidden" asp-for="ReturnUrl" />
                    <input type="hidden" asp-for="Provider" />
                    <input type="hidden" asp-for="Email" />
                    <div class="mb-3">
                        <label asp-for="Nickname" class="form-label"></label>
                        <input asp-for="Nickname" class="form-control" maxlength="20" autofocus />
                        <div class="form-text">3–20 символа: букви, цифри и долна черта (_).</div>
                        <span asp-validation-for="Nickname" class="text-danger small"></span>
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Продължи</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
