@model ProfileViewModel
@{
    ViewData["Title"] = "Моят профил";
}

<div class="row g-4">
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-body text-center">
                <i class="bi bi-person-circle display-3 text-primary"></i>
                <h3 class="mt-2 mb-0">@Model.User.Nickname</h3>
                <div class="text-body-secondary">@Model.User.Email</div>
                <div class="small text-body-secondary mt-2">Регистриран на @Model.User.RegisteredAt.ToLocalTime().ToString("dd.MM.yyyy")</div>
            </div>
        </div>

        <div class="card border-0 shadow-sm mb-3">
            <div class="card-body">
                <h5 class="section-title mb-3">Следени модели</h5>
                @if (Model.Follows.Any())
                {
                    <ul class="list-unstyled mb-0">
                        @foreach (var f in Model.Follows)
                        {
                            <li class="d-flex justify-content-between align-items-center mb-2">
                                <a asp-controller="Models" asp-action="Details" asp-route-id="@f.CarModelId">@f.CarModel?.FullName</a>
                                <form asp-controller="Models" asp-action="Unfollow" asp-route-id="@f.CarModelId" asp-route-returnUrl="@Url.Action("Profile")" method="post">
                                    <button class="btn btn-sm btn-link text-danger p-0" title="Спри да следиш"><i class="bi bi-bell-slash"></i></button>
                                </form>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p class="small text-body-secondary mb-0">Не следите модели. Натиснете „Следи модела“ на страницата на модел, за да получавате известия.</p>
                }
            </div>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <h5 class="section-title mb-3">Последни влизания</h5>
                <ul class="list-unstyled small mb-0">
                    @foreach (var l in Model.RecentLogins)
                    {
                        <li class="mb-1">
                            <i class="bi @(l.Succeeded ? "bi-check-circle text-success" : "bi-x-circle text-danger") me-1"></i>
                            @l.LoggedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm") · @l.Method
                            @if (!l.Succeeded) { <span class="text-danger">(@l.FailureReason)</span> }
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h4 class="section-title mb-0">Моите отзиви (@Model.Entries.Count)</h4>
            <a asp-controller="Cars" asp-action="Create" class="btn btn-primary btn-sm"><i class="bi bi-plus-circle me-1"></i>Добави</a>
        </div>
        @if (Model.Entries.Any())
        {
            <div class="row row-cols-1 row-cols-md-2 g-3">
                @foreach (var e in Model.Entries)
                {
                    <div class="col"><partial name="_EntryCard" model="e" /></div>
                }
            </div>
        }
        else
        {
            <p class="text-body-secondary">Все още нямате отзиви.</p>
        }
    </div>
</div>
