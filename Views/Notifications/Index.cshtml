@model List<Notification>
@{
    ViewData["Title"] = "Известия";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <h2 class="mb-0"><i class="bi bi-bell me-2 text-primary"></i>Известия</h2>
    @if (Model.Any())
    {
        <div class="d-flex gap-2">
            <form asp-action="MarkAllRead" method="post"><button class="btn btn-outline-primary btn-sm"><i class="bi bi-check2-all me-1"></i>Маркирай всички като прочетени</button></form>
            <form asp-action="DeleteAll" method="post" onsubmit="return confirm('Да изтрия ли всички известия?')"><button class="btn btn-outline-danger btn-sm"><i class="bi bi-trash me-1"></i>Изтрий всички</button></form>
        </div>
    }
</div>

@if (Model.Any())
{
    <div class="list-group shadow-sm">
        @foreach (var n in Model)
        {
            <a asp-action="Open" asp-route-id="@n.Id" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center @(n.IsRead ? "" : "fw-semibold")">
                <span><i class="bi @(n.IsRead ? "bi-bell text-body-secondary" : "bi-bell-fill text-primary") me-2"></i>@n.Message</span>
                <small class="text-body-secondary text-nowrap ms-3">@n.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</small>
            </a>
        }
    </div>
}
else
{
    <div class="text-center py-5">
        <i class="bi bi-bell-slash display-3 text-body-secondary"></i>
        <h5 class="mt-3">Нямате известия</h5>
        <p class="text-body-secondary">Натиснете „Следи модела“ на страницата на модел и ще получавате известие (и имейл), когато някой добави нови данни за него.</p>
    </div>
}
