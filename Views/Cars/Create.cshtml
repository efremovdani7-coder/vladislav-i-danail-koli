@model CarEntryFormViewModel
@{
    ViewData["Title"] = "Добави автомобил";
}

<h2 class="mb-1"><i class="bi bi-plus-circle me-2 text-primary"></i>Добави автомобил</h2>
<p class="text-body-secondary mb-4">Изберете марката, модела и двигателя от менютата — след всяка стъпка се показват само възможностите за избраната кола. Пробегът, разходите и оценката въвеждате сами.</p>

<div class="row g-4">
    <div class="col-lg-9">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <form asp-action="Create" method="post" novalidate>
                    <partial name="_EntryForm" model="Model" />
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary btn-lg"><i class="bi bi-check-circle me-2"></i>Добави</button>
                        <a asp-action="Index" class="btn btn-outline-secondary btn-lg">Отказ</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <div class="col-lg-3">
        <div class="card border-0 shadow-sm bg-primary-subtle">
            <div class="card-body">
                <h6><i class="bi bi-lightbulb me-2"></i>Съвети</h6>
                <ul class="small mb-0 ps-3">
                    <li>Оценявайте обективно — според реалния опит.</li>
                    <li>Отбележете всички системи, по които е имало ремонт.</li>
                    <li>Разходите за поддръжка са средно за една година (сервиз, части, ремонти).</li>
                </ul>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/entry-form.js" asp-append-version="true"></script>
}
