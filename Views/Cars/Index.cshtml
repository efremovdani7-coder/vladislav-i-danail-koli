@model CarListViewModel
@{
    ViewData["Title"] = "Всички отзиви";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <h2 class="mb-0"><i class="bi bi-card-list me-2 text-primary"></i>Всички отзиви</h2>
    <div class="d-flex gap-2">
        <a asp-action="Search" class="btn btn-outline-primary"><i class="bi bi-funnel me-1"></i>Справки</a>
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-circle me-1"></i>Добави отзив</a>
    </div>
</div>

@if (Model.Entries.Any())
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-3">
        @foreach (var e in Model.Entries)
        {
            <div class="col"><partial name="_EntryCard" model="e" /></div>
        }
    </div>

    @if (Model.TotalPages > 1)
    {
        <nav class="mt-4" aria-label="Страници">
            <ul class="pagination justify-content-center flex-wrap">
                @for (var p = 1; p <= Model.TotalPages; p++)
                {
                    <li class="page-item @(p == Model.CurrentPage ? "active" : "")"><a class="page-link" asp-action="Index" asp-route-page="@p">@p</a></li>
                }
            </ul>
        </nav>
    }
}
else
{
    <div class="text-center py-5">
        <i class="bi bi-car-front display-1 text-primary opacity-50"></i>
        <h4 class="mt-3">Все още няма отзиви</h4>
        <p class="text-body-secondary">Споделете опита си с вашия автомобил първи.</p>
        <a asp-action="Create" class="btn btn-primary btn-lg"><i class="bi bi-plus-circle me-2"></i>Добави автомобил</a>
    </div>
}
