@model CarSearchViewModel
@{
    ViewData["Title"] = "Справки";
    var thisYear = DateTime.Now.Year;
}

<h2 class="mb-1"><i class="bi bi-funnel me-2 text-primary"></i>Справки</h2>
<p class="text-body-secondary">Филтрирайте отзивите по марка, модел, година и гориво. Резултатите се обновяват веднага.</p>

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <form asp-action="Search" method="get" id="search-form">
            <div class="row g-3">
                <div class="col-md-6 col-lg-3">
                    <label asp-for="BrandId" class="form-label fw-semibold">Марка</label>
                    <select asp-for="BrandId" asp-items="Model.Brands" class="form-select"
                            data-cascade-target="#ModelId" data-cascade-url="/api/catalog/models?brandId="
                            data-cascade-empty="— Всички модели —" data-cascade-disabled="— Първо изберете марка —">
                        <option value="">— Всички марки —</option>
                    </select>
                </div>
                <div class="col-md-6 col-lg-3">
                    <label asp-for="ModelId" class="form-label fw-semibold">Модел</label>
                    <select asp-for="ModelId" asp-items="Model.Models" class="form-select" disabled="@(!Model.BrandId.HasValue)">
                        <option value="">@(Model.BrandId.HasValue ? "— Всички модели —" : "— Първо изберете марка —")</option>
                    </select>
                </div>
                <div class="col-6 col-lg-2">
                    <label asp-for="YearFrom" class="form-label fw-semibold">Година от</label>
                    <select asp-for="YearFrom" class="form-select">
                        <option value="">—</option>
                        @for (var y = thisYear; y >= 1990; y--) { <option value="@y" selected="@(Model.YearFrom == y)">@y</option> }
                    </select>
                </div>
                <div class="col-6 col-lg-2">
                    <label asp-for="YearTo" class="form-label fw-semibold">Година до</label>
                    <select asp-for="YearTo" class="form-select">
                        <option value="">—</option>
                        @for (var y = thisYear; y >= 1990; y--) { <option value="@y" selected="@(Model.YearTo == y)">@y</option> }
                    </select>
                </div>
                <div class="col-6 col-lg-2">
                    <label asp-for="Fuel" class="form-label fw-semibold">Гориво</label>
                    <select asp-for="Fuel" class="form-select">
                        <option value="">— Всички —</option>
                        @foreach (var f in Enum.GetValues<FuelType>()) { <option value="@f" selected="@(Model.Fuel == f)">@EnumText.Fuel(f)</option> }
                    </select>
                </div>
                <div class="col-6 col-lg-3">
                    <label asp-for="MinRating" class="form-label fw-semibold">Минимална оценка</label>
                    <select asp-for="MinRating" class="form-select">
                        <option value="">— Без значение —</option>
                        @for (var i = 9; i >= 1; i--) { <option value="@i" selected="@(Model.MinRating == i)">@i и нагоре</option> }
                    </select>
                </div>
                <div class="col-lg-3 d-flex align-items-end gap-2">
                    <button type="submit" class="btn btn-primary flex-grow-1"><i class="bi bi-search me-1"></i>Търси</button>
                    <a asp-action="Search" class="btn btn-outline-secondary" title="Изчисти филтрите"><i class="bi bi-x-lg"></i></a>
                </div>
            </div>
        </form>
    </div>
</div>

<div id="search-results">
    <partial name="_SearchResults" model="Model" />
</div>

@section Scripts {
    <script>
        // US02: резултатите се обновяват без презареждане на страницата
        (function () {
            const form = document.getElementById('search-form');
            const results = document.getElementById('search-results');
            let page = @Model.CurrentPage;

            async function run() {
                const params = new URLSearchParams(new FormData(form));
                for (const [k, v] of [...params.entries()]) { if (v === '') params.delete(k); }
                if (page > 1) params.set('CurrentPage', page);
                const url = form.action + (params.toString() ? '?' + params.toString() : '');
                results.style.opacity = '.5';
                try {
                    const res = await fetch(url, { headers: { 'X-Requested-With': 'fetch' } });
                    results.innerHTML = await res.text();
                    history.replaceState(null, '', url);
                } finally {
                    results.style.opacity = '1';
                }
            }

            form.addEventListener('change', function () { page = 1; run(); });
            form.addEventListener('submit', function (e) { e.preventDefault(); page = 1; run(); });
            results.addEventListener('click', function (e) {
                const link = e.target.closest('[data-page]');
                if (!link) return;
                e.preventDefault();
                page = parseInt(link.dataset.page, 10);
                run();
                window.scrollTo({ top: results.offsetTop - 90, behavior: 'smooth' });
            });
        })();
    </script>
}
