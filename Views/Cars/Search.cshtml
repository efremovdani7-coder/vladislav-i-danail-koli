@model CarSearchViewModel
@{
    ViewData["Title"] = "Търсене";
}

<h2 class="mb-4"><i class="bi bi-search me-2"></i>Търсене на автомобил</h2>

<!-- Search Form -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <form asp-action="Search" method="get">
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Марка</label>
                    <select asp-for="Brand" class="form-select">
                        <option value="">— Всички марки —</option>
                        @foreach (var brand in Model.AvailableBrands)
                        {
                            <option value="@brand.Name" selected="@(Model.Brand == brand.Name)">@brand.Name</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Модел</label>
                    <input asp-for="Model" class="form-control" placeholder="напр. Corolla" />
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-semibold">Година от</label>
                    <input asp-for="YearFrom" type="number" class="form-control" placeholder="2000" />
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-semibold">Година до</label>
                    <input asp-for="YearTo" type="number" class="form-control" placeholder="2024" />
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Тип двигател</label>
                    <select asp-for="EngineType" class="form-select" asp-items="Html.GetEnumSelectList<EngineType>()">
                        <option value="">— Всички —</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Мин. оценка за надеждност</label>
                    <select asp-for="MinRating" class="form-select">
                        <option value="">— Без филтър —</option>
                        @for (int i = 1; i <= 10; i++)
                        {
                            <option value="@i">@i и нагоре</option>
                        }
                    </select>
                </div>
                <div class="col-md-4 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-search me-2"></i>Търси
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- Results -->
@if (Model.Results.Any())
{
    <h4 class="mb-3">Намерени: @Model.Results.Count резултата</h4>
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Марка</th>
                    <th>Модел</th>
                    <th>Година</th>
                    <th>Пробег</th>
                    <th>Двигател</th>
                    <th>Оценка</th>
                    <th>От</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var entry in Model.Results)
                {
                    <tr>
                        <td class="fw-semibold">@entry.CarBrand?.Name</td>
                        <td>@entry.Model</td>
                        <td>@entry.Year</td>
                        <td>@entry.Mileage.ToString("N0") км</td>
                        <td>@Html.DisplayFor(m => entry.EngineType)</td>
                        <td>
                            <span class="badge @(entry.ReliabilityRating >= 7 ? "bg-success" : entry.ReliabilityRating >= 4 ? "bg-warning" : "bg-danger")">
                                @entry.ReliabilityRating/10
                            </span>
                        </td>
                        <td><small>@entry.User?.Nickname</small></td>
                        <td>
                            <a asp-controller="Cars" asp-action="Details" asp-route-id="@entry.Id"
                               class="btn btn-outline-primary btn-sm">Виж</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else if (Context.Request.QueryString.HasValue)
{
    <div class="text-center py-4">
        <i class="bi bi-emoji-frown display-3 text-muted"></i>
        <h5 class="mt-3">Няма намерени резултати</h5>
        <p class="text-muted">Опитай с различни критерии за търсене.</p>
    </div>
}
