@model CarSearchViewModel
@{
    ViewData["Title"] = "Търсене";
}

<h2 class="mb-4"><i class="bi bi-search me-2"></i>Търсене на автомобил</h2>

<!-- Search Form -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <form asp-action="Search" method="get" id="search-form">
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Марка</label>
                    <select asp-for="Brand" class="form-select" id="brand-select">
                        <option value="">— Всички марки —</option>
                        @foreach (var brand in Model.AvailableBrands)
                        {
                            <option value="@brand.Name" selected="@(Model.Brand == brand.Name)">@brand.Name</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Модел</label>
                    <select asp-for="Model" class="form-select" id="model-select" disabled="@(string.IsNullOrEmpty(Model.Brand))">
                        <option value="">@(string.IsNullOrEmpty(Model.Brand) ? "— Първо избери марка —" : "— Всички модели —")</option>
                        @foreach (var m in Model.AvailableModels)
                        {
                            <option value="@m" selected="@(Model.Model == m)">@m</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-semibold">Година от</label>
                    <input asp-for="YearFrom" type="number" class="form-control" placeholder="2000" />
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-semibold">Година до</label>
                    <input asp-for="YearTo" type="number" class="form-control" placeholder="2024" />
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Тип двигател</label>
                    <select asp-for="EngineType" class="form-select" asp-items="Html.GetEnumSelectList<EngineType>()">
                        <option value="">— Всички —</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Мин. оценка за надеждност</label>
                    <select asp-for="MinRating" class="form-select">
                        <option value="">— Без филтър —</option>
                        @for (int i = 1; i <= 10; i++)
                        {
                            <option value="@i" selected="@(Model.MinRating == i)">@i и нагоре</option>
                        }
                    </select>
                </div>
                <div class="col-md-4 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-search me-2"></i>Търси
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- Results (updated without reloading the page) -->
<div id="search-results">
    <partial name="_SearchResults" model="Model" />
</div>

@section Scripts {
<script>
// US02: cascading make -> model dropdown and live search without page reload
(function () {
    const form = document.getElementById('search-form');
    const brandSelect = document.getElementById('brand-select');
    const modelSelect = document.getElementById('model-select');
    const results = document.getElementById('search-results');
    let currentPage = @Model.CurrentPage;
    let timer = null;

    async function loadModels() {
        const brand = brandSelect.value;
        modelSelect.innerHTML = '';
        const first = document.createElement('option');
        first.value = '';
        first.textContent = brand ? '— Всички модели —' : '— Първо избери марка —';
        modelSelect.appendChild(first);
        modelSelect.disabled = !brand;
        if (!brand) return;

        const response = await fetch('@Url.Action("Models", "Cars")?brand=' + encodeURIComponent(brand));
        const models = await response.json();
        models.forEach(function (m) {
            const opt = document.createElement('option');
            opt.value = m;
            opt.textContent = m;
            modelSelect.appendChild(opt);
        });
    }

    async function runSearch() {
        const params = new URLSearchParams(new FormData(form));
        for (const [key, value] of [...params.entries()]) {
            if (value === '') params.delete(key);
        }
        if (currentPage > 1) params.set('CurrentPage', currentPage);

        const url = form.action + '?' + params.toString();
        results.style.opacity = '0.5';
        try {
            const response = await fetch(url, { headers: { 'X-Requested-With': 'fetch' } });
            results.innerHTML = await response.text();
            history.replaceState(null, '', url);
        } finally {
            results.style.opacity = '1';
        }
    }

    function searchSoon(delay) {
        clearTimeout(timer);
        timer = setTimeout(runSearch, delay);
    }

    brandSelect.addEventListener('change', async function () {
        currentPage = 1;
        await loadModels();
        runSearch();
    });

    form.addEventListener('change', function (e) {
        if (e.target === brandSelect) return;
        currentPage = 1;
        searchSoon(0);
    });

    // Year fields: wait until the user stops typing
    form.querySelectorAll('input[type=number]').forEach(function (input) {
        input.addEventListener('input', function () {
            currentPage = 1;
            searchSoon(400);
        });
    });

    form.addEventListener('submit', function (e) {
        e.preventDefault();
        currentPage = 1;
        runSearch();
    });

    results.addEventListener('click', function (e) {
        const link = e.target.closest('[data-page]');
        if (!link) return;
        e.preventDefault();
        currentPage = parseInt(link.dataset.page, 10);
        runSearch();
        window.scrollTo({ top: results.offsetTop - 80, behavior: 'smooth' });
    });
})();
</script>
}
