@model HomeViewModel
@{
    ViewData["Title"] = "Начало";
}

<!-- Hero Section -->
<div class="p-5 mb-4 bg-primary bg-gradient text-white rounded-4 shadow">
    <div class="container-fluid py-3">
        <h1 class="display-5 fw-bold">
            <i class="bi bi-car-front-fill me-3"></i>АвтоНадеждност.бг
        </h1>
        <p class="col-md-8 fs-5">
            Разбери кои автомобили са най-надеждни! Споделяй своя опит и помагай на другите
            да направят правилния избор при покупка на кола.
        </p>
        <div class="d-flex flex-wrap gap-2 mt-3">
            <a asp-controller="Cars" asp-action="Search" class="btn btn-light btn-lg">
                <i class="bi bi-search me-2"></i>Търси по марка
            </a>
            <a asp-controller="Cars" asp-action="Create" class="btn btn-outline-light btn-lg">
                <i class="bi bi-plus-circle me-2"></i>Добави кола
            </a>
        </div>
    </div>
</div>

<!-- Statistics -->
<div class="row g-3 mb-5">
    <div class="col-6 col-md-3">
        <div class="card text-center border-0 shadow-sm h-100">
            <div class="card-body">
                <i class="bi bi-car-front display-4 text-primary"></i>
                <h3 class="mt-2 mb-0">@Model.TotalCars</h3>
                <small class="text-muted">Автомобила</small>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card text-center border-0 shadow-sm h-100">
            <div class="card-body">
                <i class="bi bi-people display-4 text-success"></i>
                <h3 class="mt-2 mb-0">@Model.TotalUsers</h3>
                <small class="text-muted">Потребители</small>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card text-center border-0 shadow-sm h-100">
            <div class="card-body">
                <i class="bi bi-tags display-4 text-warning"></i>
                <h3 class="mt-2 mb-0">@Model.TotalBrands</h3>
                <small class="text-muted">Марки</small>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card text-center border-0 shadow-sm h-100">
            <div class="card-body">
                <i class="bi bi-star display-4 text-danger"></i>
                <h3 class="mt-2 mb-0">@Model.AverageRating<small>/10</small></h3>
                <small class="text-muted">Средна оценка</small>
            </div>
        </div>
    </div>
</div>

<!-- Top Brands -->
@if (Model.TopBrands.Any())
{
    <h3 class="mb-3"><i class="bi bi-trophy me-2"></i>Най-надеждни марки</h3>
    <div class="row g-3 mb-5">
        @foreach (var brand in Model.TopBrands)
        {
            <div class="col-6 col-md">
                <div class="card border-0 shadow-sm text-center h-100">
                    <div class="card-body">
                        <h5 class="card-title">@brand.BrandName</h5>
                        <div class="display-6 text-primary fw-bold">@brand.AvgRating</div>
                        <small class="text-muted">@brand.Count отзива</small>
                    </div>
                </div>
            </div>
        }
    </div>
}

<!-- Latest Entries -->
@if (Model.LatestEntries.Any())
{
    <h3 class="mb-3"><i class="bi bi-clock-history me-2"></i>Последно добавени</h3>
    <div class="row g-3">
        @foreach (var entry in Model.LatestEntries)
        {
            <div class="col-sm-6 col-lg-4">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start">
                            <h5 class="card-title mb-1">
                                @entry.CarBrand?.Name @entry.Model
                            </h5>
                            <span class="badge bg-primary rounded-pill fs-6">@entry.ReliabilityRating/10</span>
                        </div>
                        <p class="text-muted mb-2">
                            <i class="bi bi-calendar me-1"></i>@entry.Year г.
                            <i class="bi bi-speedometer2 ms-2 me-1"></i>@entry.Mileage.ToString("N0") км
                        </p>
                        @if (!string.IsNullOrEmpty(entry.Comment))
                        {
                            <p class="card-text small">
                                @(entry.Comment.Length > 120 ? entry.Comment[..120] + "..." : entry.Comment)
                            </p>
                        }
                        <div class="d-flex justify-content-between align-items-center mt-auto">
                            <small class="text-muted">
                                <i class="bi bi-person me-1"></i>@entry.User?.Nickname
                            </small>
                            <a asp-controller="Cars" asp-action="Details" asp-route-id="@entry.Id"
                               class="btn btn-outline-primary btn-sm">Виж повече</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="text-center py-5">
        <i class="bi bi-emoji-smile display-1 text-muted"></i>
        <h4 class="mt-3">Все още няма добавени автомобили</h4>
        <p class="text-muted">Бъди първият, който сподели своя опит!</p>
        <a asp-controller="Cars" asp-action="Create" class="btn btn-primary btn-lg">
            <i class="bi bi-plus-circle me-2"></i>Добави първия автомобил
        </a>
    </div>
}
