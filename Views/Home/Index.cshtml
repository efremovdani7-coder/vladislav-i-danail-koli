@model HomeViewModel
@{
    ViewData["Title"] = "Начало";
}

<section class="hero p-4 p-md-5 mb-4 shadow">
    <div class="row align-items-center g-4">
        <div class="col-lg-7">
            <h1 class="fw-bold mb-3">Колко надеждна е колата, която караш или искаш да купиш?</h1>
            <p class="lead mb-4">Реални данни от собственици за дефекти, разходи за поддръжка и пробег —
                обобщени в индекс на надеждност за всеки модел и всяка марка.</p>
            <div class="d-flex flex-wrap gap-2">
                <a asp-controller="Cars" asp-action="Create" class="btn btn-light btn-lg text-primary fw-semibold"><i class="bi bi-plus-circle me-2"></i>Сподели опита си</a>
                <a asp-controller="Compare" asp-action="Index" class="btn btn-outline-light btn-lg"><i class="bi bi-layout-split me-2"></i>Сравни модели</a>
            </div>
        </div>
        <div class="col-lg-5">
            <div class="row g-2">
                <div class="col-6"><div class="stat-tile"><div class="value">@Model.TotalEntries</div><div class="label">отзива от собственици</div></div></div>
                <div class="col-6"><div class="stat-tile"><div class="value">@Model.TotalUsers</div><div class="label">регистрирани потребители</div></div></div>
                <div class="col-6"><div class="stat-tile"><div class="value">@Model.CatalogBrands</div><div class="label">марки в каталога</div></div></div>
                <div class="col-6"><div class="stat-tile"><div class="value">@Model.CatalogModels.ToString("N0")</div><div class="label">модела с двигатели</div></div></div>
            </div>
        </div>
    </div>
</section>

<div class="row g-4">
    <!-- Обща оценка за всяка марка -->
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h4 class="section-title mb-0">Надеждност по марки</h4>
                    <a asp-controller="Brands" asp-action="Index" class="btn btn-sm btn-outline-primary">Всички марки</a>
                </div>
                @if (Model.BrandRanking.Any())
                {
                    <div class="chart-box mb-3"><canvas id="brandChart" aria-label="Индекс на надеждност по марки"></canvas></div>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead><tr><th>#</th><th>Марка</th><th class="text-center">Отзиви</th><th class="text-center">Ср. оценка</th><th class="text-end">Индекс</th></tr></thead>
                            <tbody>
                                @for (var i = 0; i < Model.BrandRanking.Count; i++)
                                {
                                    var b = Model.BrandRanking[i];
                                    <tr>
                                        <td class="text-body-secondary">@(i + 1)</td>
                                        <td class="fw-semibold"><a asp-controller="Brands" asp-action="Details" asp-route-id="@b.BrandId" class="text-decoration-none">@b.BrandName</a></td>
                                        <td class="text-center">@b.Stats.Entries</td>
                                        <td class="text-center">@(b.Stats.Entries > 0 ? b.Stats.AvgRating.ToString("0.0") + "/10" : "—")</td>
                                        <td class="text-end"><partial name="_IndexBadge" model="b.Stats" /></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-5 text-body-secondary">
                        <i class="bi bi-bar-chart display-4"></i>
                        <p class="mt-2 mb-0">Все още няма отзиви. Бъдете първият, който ще сподели опита си!</p>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Най-надеждни модели -->
    <div class="col-lg-5">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <h4 class="section-title mb-3">Най-надеждни модели</h4>
                @if (Model.TopModels.Any())
                {
                    <div class="list-group list-group-flush">
                        @foreach (var m in Model.TopModels)
                        {
                            <a asp-controller="Models" asp-action="Details" asp-route-id="@m.ModelId" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center px-0">
                                <span>
                                    <span class="fw-semibold">@m.BrandName @m.ModelName</span><br />
                                    <small class="text-body-secondary">@m.Stats.Entries отзива</small>
                                </span>
                                <partial name="_IndexBadge" model="m.Stats" />
                            </a>
                        }
                    </div>
                }
                else
                {
                    <p class="text-body-secondary">Класацията ще се появи след първите отзиви.</p>
                }
                <hr />
                <h6 class="text-body-secondary">Как се изчислява индексът?</h6>
                <p class="small text-body-secondary mb-0">
                    Оценка на собствениците (50%), честота на дефектите (20%), разходи за поддръжка (15%) и звезди от потребителите (15%).
                    <span class="badge text-bg-success">80–100</span> висока,
                    <span class="badge text-bg-warning">50–79</span> средна,
                    <span class="badge text-bg-danger">1–49</span> ниска надеждност.
                </p>
            </div>
        </div>
    </div>
</div>

<h4 class="section-title mt-5 mb-3">Последно добавени</h4>
@if (Model.LatestEntries.Any())
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-3">
        @foreach (var e in Model.LatestEntries)
        {
            <div class="col"><partial name="_EntryCard" model="e" /></div>
        }
    </div>
}
else
{
    <p class="text-body-secondary">Няма добавени отзиви.</p>
}

@section Scripts {
    @if (Model.BrandRanking.Any())
    {
        <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
        <script>
            (function () {
                const labels = @Json.Serialize(Model.BrandRanking.Select(b => b.BrandName));
                const values = @Json.Serialize(Model.BrandRanking.Select(b => b.Stats.Index));
                const colors = values.map(v => v >= 80 ? '#198754' : v >= 50 ? '#f0ad00' : '#dc3545');
                new Chart(document.getElementById('brandChart'), {
                    type: 'bar',
                    data: { labels, datasets: [{ label: 'Индекс на надеждност', data: values, backgroundColor: colors, borderRadius: 6 }] },
                    options: { maintainAspectRatio: false, plugins: { legend: { display: false } }, scales: { y: { min: 0, max: 100 } } }
                });
            })();
        </script>
    }
}
