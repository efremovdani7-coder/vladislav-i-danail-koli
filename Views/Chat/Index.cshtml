@model ChatViewModel
@{
    ViewData["Title"] = Model.Partner != null ? $"Чат с {Model.Partner.Nickname}" : "Чат";
}

<h2 class="mb-4"><i class="bi bi-chat-dots me-2 text-primary"></i>Чат</h2>

<div class="row g-4">
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-body">
                <label for="new-chat" class="form-label fw-semibold">Нов разговор</label>
                <select id="new-chat" class="form-select" onchange="if (this.value) location.href='@Url.Action("Index")?userId=' + encodeURIComponent(this.value)">
                    <option value="">— Изберете потребител —</option>
                    @foreach (var u in Model.OtherUsers)
                    {
                        <option value="@u.Id">@u.Nickname</option>
                    }
                </select>
            </div>
        </div>

        <div class="list-group conversation-list shadow-sm">
            @foreach (var c in Model.Conversations)
            {
                <a asp-action="Index" asp-route-userId="@c.UserId" class="list-group-item list-group-item-action @(Model.Partner?.Id == c.UserId ? "active" : "")" data-user="@c.UserId">
                    <div class="d-flex justify-content-between">
                        <strong>@c.Nickname</strong>
                        @if (c.Unread > 0)
                        {
                            <span class="badge rounded-pill bg-danger">@c.Unread</span>
                        }
                    </div>
                    <div class="small text-truncate opacity-75">@c.LastText</div>
                </a>
            }
            @if (!Model.Conversations.Any())
            {
                <div class="list-group-item text-body-secondary small">Все още нямате разговори.</div>
            }
        </div>
    </div>

    <div class="col-lg-8">
        @if (Model.Partner != null)
        {
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-transparent d-flex align-items-center">
                    <i class="bi bi-person-circle fs-4 me-2 text-primary"></i>
                    <strong>@Model.Partner.Nickname</strong>
                    <span id="chat-status" class="ms-auto small text-body-secondary">свързване...</span>
                </div>
                <div class="card-body">
                    <div id="chat-box" class="chat-box p-3 d-flex flex-column gap-2">
                        @foreach (var m in Model.Messages)
                        {
                            <div class="chat-msg @(m.SenderId == Model.MyId ? "mine" : "theirs")">@m.Text<span class="time">@m.SentAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</span></div>
                        }
                        @if (!Model.Messages.Any())
                        {
                            <div id="chat-empty" class="text-center text-body-secondary small my-auto">Започнете разговора с @Model.Partner.Nickname.</div>
                        }
                    </div>
                    <form id="chat-form" class="d-flex gap-2 mt-3" autocomplete="off">
                        <input id="chat-input" class="form-control" maxlength="1000" placeholder="Напишете съобщение..." aria-label="Съобщение" />
                        <button id="chat-send" class="btn btn-primary" type="submit" disabled><i class="bi bi-send"></i><span class="d-none d-sm-inline ms-1">Изпрати</span></button>
                    </form>
                </div>
            </div>
        }
        else
        {
            <div class="card border-0 shadow-sm">
                <div class="card-body text-center py-5">
                    <i class="bi bi-chat-square-text display-3 text-primary opacity-50"></i>
                    <h5 class="mt-3">Изберете разговор</h5>
                    <p class="text-body-secondary mb-0">Обменяйте информация директно с други собственици на автомобили.</p>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    @if (Model.Partner != null)
    {
        <script>
            (function () {
                const partnerId = @Json.Serialize(Model.Partner.Id);
                window.activeChatPartnerId = partnerId;
                const box = document.getElementById('chat-box');
                const form = document.getElementById('chat-form');
                const input = document.getElementById('chat-input');
                const send = document.getElementById('chat-send');
                const status = document.getElementById('chat-status');
                const conn = window.chatConnection;
                box.scrollTop = box.scrollHeight;

                const add = function (m, mine) {
                    const empty = document.getElementById('chat-empty');
                    if (empty) empty.remove();
                    const div = document.createElement('div');
                    div.className = 'chat-msg ' + (mine ? 'mine' : 'theirs');
                    div.textContent = m.text;
                    const time = document.createElement('span');
                    time.className = 'time';
                    time.textContent = m.sentAt;
                    div.appendChild(time);
                    box.appendChild(div);
                    box.scrollTop = box.scrollHeight;
                };

                if (!conn) { status.textContent = 'няма връзка'; return; }

                conn.on('receiveMessage', function (m) {
                    if (m.senderId !== partnerId) return;
                    add(m, false);
                    conn.invoke('MarkRead', partnerId).catch(function () { });
                });
                conn.on('messageSent', function (m) {
                    if (m.receiverId === partnerId) add(m, true);
                });

                const ready = function () { status.textContent = 'на линия'; send.disabled = false; };
                const waitForConnection = function () {
                    if (conn.state === 'Connected') { ready(); return; }
                    setTimeout(waitForConnection, 300);
                };
                waitForConnection();
                conn.onreconnecting(function () { status.textContent = 'повторно свързване...'; send.disabled = true; });
                conn.onreconnected(ready);

                form.addEventListener('submit', function (e) {
                    e.preventDefault();
                    const text = input.value.trim();
                    if (!text) return;
                    conn.invoke('SendMessage', partnerId, text)
                        .then(function () { input.value = ''; input.focus(); })
                        .catch(function () { status.textContent = 'грешка при изпращане'; });
                });
            })();
        </script>
    }
}
