@model CarEntry
<div class="card h-100 border-0 shadow-sm car-card">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-start gap-2">
            <div>
                <h5 class="card-title mb-0">
                    <a class="stretched-link text-decoration-none" asp-controller="Cars" asp-action="Details" asp-route-id="@Model.Id">
                        @Model.CarModel?.CarBrand?.Name @Model.CarModel?.Name
                    </a>
                </h5>
                <div class="text-body-secondary small">@Model.Year г. · @Model.CarEngine?.Name</div>
            </div>
            <span class="badge rating-badge text-bg-@(Model.ReliabilityRating >= 8 ? "success" : Model.ReliabilityRating >= 5 ? "warning" : "danger")">@Model.ReliabilityRating/10</span>
        </div>
        <div class="d-flex flex-wrap gap-3 small mt-3 text-body-secondary">
            <span><i class="bi bi-speedometer2 me-1 text-primary"></i>@Model.Mileage.ToString("N0") км</span>
            @if (Model.CarEngine != null)
            {
                <span><i class="bi bi-fuel-pump me-1 text-primary"></i>@EnumText.Fuel(Model.CarEngine.FuelType)</span>
            }
            @if (Model.MaintenanceCost.HasValue)
            {
                <span><i class="bi bi-cash-coin me-1 text-primary"></i>@Model.MaintenanceCost.Value.ToString("N0") €/год.</span>
            }
        </div>
    </div>
    <div class="card-footer bg-transparent border-0 small text-body-secondary pt-0">
        <i class="bi bi-person me-1"></i>@Model.User?.Nickname · @Model.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy")
    </div>
</div>
