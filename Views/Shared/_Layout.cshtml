@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@{
    var signedIn = SignInManager.IsSignedIn(User);
    var currentUser = signedIn ? await UserManager.GetUserAsync(User) : null;
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    string Active(string name) => controller == name ? "active" : "";
}
<!DOCTYPE html>
<html lang="bg" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — АвтоНадеждност.бг</title>
    <script>
        // US08: тъмна/светла тема — прилага се преди зареждане на страницата, за да няма „премигване“
        (function () {
            try {
                var t = localStorage.getItem('theme');
                if (t === 'dark' || t === 'light') document.documentElement.setAttribute('data-bs-theme', t);
            } catch (e) { }
        })();
    </script>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
    <nav class="navbar navbar-expand-xl navbar-dark navbar-blue sticky-top shadow-sm">
        <div class="container-xl">
            <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">
                <i class="bi bi-car-front-fill me-1"></i>АвтоНадеждност<span class="text-info">.бг</span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                    aria-controls="mainNav" aria-expanded="false" aria-label="Меню">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item"><a class="nav-link @Active("Cars")" asp-controller="Cars" asp-action="Index"><i class="bi bi-card-list me-1"></i>Отзиви</a></li>
                    <li class="nav-item"><a class="nav-link @Active("Brands")" asp-controller="Brands" asp-action="Index"><i class="bi bi-trophy me-1"></i>Марки</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Cars" asp-action="Search"><i class="bi bi-funnel me-1"></i>Справки</a></li>
                    <li class="nav-item"><a class="nav-link @Active("Compare")" asp-controller="Compare" asp-action="Index"><i class="bi bi-layout-split me-1"></i>Сравнение</a></li>
                    @if (signedIn)
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Cars" asp-action="Create"><i class="bi bi-plus-circle me-1"></i>Добави</a></li>
                    }
                </ul>

                <!-- US09: търсачка с подсказки -->
                <form class="site-search position-relative my-2 my-xl-0 me-xl-2" asp-controller="Cars" asp-action="Search" method="get" role="search" autocomplete="off">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-white border-0"><i class="bi bi-search text-primary"></i></span>
                        <input id="site-search" class="form-control border-0" type="search" placeholder="Търси марка или модел..." aria-label="Търсене" />
                    </div>
                    <div id="site-search-results" class="list-group shadow search-suggestions d-none"></div>
                </form>

                <ul class="navbar-nav align-items-xl-center">
                    <li class="nav-item">
                        <button id="theme-toggle" class="btn btn-link nav-link px-2" type="button" title="Смяна на тема (тъмна / светла)">
                            <i class="bi bi-moon-stars-fill theme-icon-dark"></i><i class="bi bi-sun-fill theme-icon-light"></i>
                            <span class="d-xl-none ms-1">Тема</span>
                        </button>
                    </li>
                    @if (signedIn)
                    {
                        @await Component.InvokeAsync("NavBadges")
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-person-circle me-1"></i>@currentUser?.Nickname
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item" asp-controller="Account" asp-action="Profile"><i class="bi bi-person me-2"></i>Моят профил</a></li>
                                @if (User.IsInRole("Admin"))
                                {
                                    <li><hr class="dropdown-divider" /></li>
                                    <li><h6 class="dropdown-header">Администрация</h6></li>
                                    <li><a class="dropdown-item" asp-controller="Admin" asp-action="Index"><i class="bi bi-database me-2"></i>Отзиви</a></li>
                                    <li><a class="dropdown-item" asp-controller="Admin" asp-action="Comments"><i class="bi bi-chat-left-text me-2"></i>Коментари</a></li>
                                    <li><a class="dropdown-item" asp-controller="Admin" asp-action="Users"><i class="bi bi-people me-2"></i>Потребители</a></li>
                                    <li><a class="dropdown-item" asp-controller="Admin" asp-action="Logins"><i class="bi bi-box-arrow-in-right me-2"></i>История на влизанията</a></li>
                                    <li><a class="dropdown-item" asp-controller="Admin" asp-action="Catalog"><i class="bi bi-cloud-download me-2"></i>Каталог и тестови данни</a></li>
                                }
                                <li><hr class="dropdown-divider" /></li>
                                <li>
                                    <form asp-controller="Account" asp-action="Logout" method="post">
                                        <button type="submit" class="dropdown-item text-danger"><i class="bi bi-box-arrow-right me-2"></i>Изход</button>
                                    </form>
                                </li>
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Login"><i class="bi bi-box-arrow-in-right me-1"></i>Вход</a></li>
                        <li class="nav-item"><a class="btn btn-light btn-sm text-primary fw-semibold ms-xl-2" asp-controller="Account" asp-action="Register">Регистрация</a></li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <main class="container-xl py-4 flex-grow-1">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Затвори"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle me-2"></i>@TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Затвори"></button>
            </div>
        }
        @RenderBody()
    </main>

    <footer class="site-footer mt-auto">
        <div class="container-xl py-4">
            <div class="row g-4 align-items-center">
                <div class="col-md-5">
                    <h5 class="fw-bold mb-1"><i class="bi bi-car-front-fill me-1"></i>АвтоНадеждност.бг</h5>
                    <p class="small mb-0 opacity-75">Реален опит на собственици с надеждността и поддръжката на автомобилите им.</p>
                </div>
                <div class="col-md-4">
                    <!-- US14: социални мрежи -->
                    <div class="d-flex gap-2 justify-content-md-center">
                        <a class="social-link" href="https://www.youtube.com" target="_blank" rel="noopener noreferrer" title="YouTube" aria-label="YouTube"><i class="bi bi-youtube"></i></a>
                        <a class="social-link" href="https://www.instagram.com" target="_blank" rel="noopener noreferrer" title="Instagram" aria-label="Instagram"><i class="bi bi-instagram"></i></a>
                        <a class="social-link" href="https://www.tiktok.com" target="_blank" rel="noopener noreferrer" title="TikTok" aria-label="TikTok"><i class="bi bi-tiktok"></i></a>
                        <a class="social-link" href="https://www.viber.com" target="_blank" rel="noopener noreferrer" title="Viber" aria-label="Viber">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M11.4 0C9.5.1 5.3.4 3 2.5 1.3 4.2.7 6.7.6 9.8c-.1 3.1-.2 8.9 5.4 10.5v2.4s0 1 .6 1.2c.8.2 1.2-.5 2-1.4l1.4-1.6c3.8.3 6.8-.4 7.1-.5.8-.3 5.1-.8 5.8-6.5.7-5.9-.4-9.6-2.3-11.3C19.9 1.6 17 .1 12.6 0h-1.2zm.3 1.8h1c3.8.1 6.2 1.3 7 2 1.6 1.4 2.4 4.6 1.9 9.6-.6 4.6-3.9 4.9-4.5 5.1-.3.1-2.7.7-5.8.5 0 0-2.3 2.7-3 3.4-.1.1-.3.2-.4.2-.2-.1-.2-.3-.2-.6v-3.9C2.9 16.7 3 11.8 3.1 9.3c.1-2.6.6-4.6 2-6C7 1.7 10.5 1.8 11.7 1.8zm.5 2.6a.4.4 0 0 0 0 .8 6.4 6.4 0 0 1 6.4 6.5.4.4 0 1 0 .8 0 7.2 7.2 0 0 0-7.2-7.3zm-4 1.1c-.3 0-.6.1-.9.3-.6.5-1.2 1.1-1 1.8 0 0 .2 1.1 1.6 3.4.6 1 1.4 2 2.2 2.8l.1.1c.9.8 1.9 1.6 2.9 2.2 2.3 1.4 3.3 1.6 3.3 1.6.8.2 1.4-.4 1.8-1 .3-.4.4-1 0-1.4-.7-.7-1.4-1.3-2.2-1.8-.5-.4-1.2-.1-1.4.3l-.5.6c-.2.3-.6.3-.6.3-3.4-.9-4.4-4.4-4.4-4.4s0-.4.3-.6l.6-.5c.3-.3.6-.9.3-1.4-.5-.8-1.1-1.5-1.8-2.2-.1-.1-.2-.1-.3-.1zm4.3.6a.4.4 0 0 0 0 .8 4.3 4.3 0 0 1 4.3 4.3.4.4 0 0 0 .8 0 5.1 5.1 0 0 0-5.1-5.1zm.3 1.9a.4.4 0 0 0 0 .8c1.2 0 2 .8 2 2a.4.4 0 1 0 .8 0 2.8 2.8 0 0 0-2.8-2.8z"/></svg>
                        </a>
                    </div>
                </div>
                <div class="col-md-3 text-md-end small opacity-75">
                    &copy; @DateTime.Now.Year АвтоНадеждност.бг<br />Владислав и Данаил
                </div>
            </div>
        </div>
    </footer>

    <!-- Известие на живо (US11) -->
    <div class="toast-container position-fixed bottom-0 end-0 p-3">
        <div id="live-toast" class="toast" role="status" aria-live="polite" aria-atomic="true">
            <div class="toast-header text-bg-primary">
                <i class="bi bi-bell-fill me-2"></i><strong class="me-auto" id="live-toast-title">Известие</strong>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="toast" aria-label="Затвори"></button>
            </div>
            <div class="toast-body" id="live-toast-body"></div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @if (signedIn)
    {
        <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@8.0.7/dist/browser/signalr.min.js"></script>
    }
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
