@model List<ModelComment>
@{
    ViewData["Title"] = "Админ — коментари";
}

<partial name="_AdminNav" />

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-blue"><tr><th>Модел</th><th>Потребител</th><th>Коментар</th><th class="d-none d-md-table-cell">Дата</th><th class="text-end"></th></tr></thead>
            <tbody>
                @foreach (var c in Model)
                {
                    <tr>
                        <td class="text-nowrap"><a asp-controller="Models" asp-action="Details" asp-route-id="@c.CarModelId" class="text-decoration-none">@c.CarModel?.FullName</a></td>
                        <td>@c.User?.Nickname</td>
                        <td class="small" style="max-width: 420px">@c.Text</td>
                        <td class="d-none d-md-table-cell small text-nowrap">@c.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                        <td class="text-end">
                            <form asp-action="DeleteComment" asp-route-id="@c.Id" method="post" onsubmit="return confirm('Да изтрия ли коментара?')">
                                <button class="btn btn-sm btn-outline-danger" title="Изтрий"><i class="bi bi-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="5" class="text-center text-body-secondary py-4">Няма коментари.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
