@model AdminDashboardViewModel
@{
    ViewData["Title"] = "Админ — отзиви";
}

<partial name="_AdminNav" />

<div class="row g-3 mb-4">
    <div class="col-6 col-md-3"><div class="card border-0 shadow-sm text-center"><div class="card-body"><div class="fs-3 fw-bold text-primary">@Model.TotalEntries</div><small class="text-body-secondary">отзива</small></div></div></div>
    <div class="col-6 col-md-3"><div class="card border-0 shadow-sm text-center"><div class="card-body"><div class="fs-3 fw-bold text-primary">@Model.TotalUsers</div><small class="text-body-secondary">потребители</small></div></div></div>
    <div class="col-6 col-md-3"><div class="card border-0 shadow-sm text-center"><div class="card-body"><div class="fs-3 fw-bold text-primary">@Model.TotalComments</div><small class="text-body-secondary">коментара</small></div></div></div>
    <div class="col-6 col-md-3"><div class="card border-0 shadow-sm text-center"><div class="card-body"><div class="fs-3 fw-bold text-primary">@Model.LoginsToday</div><small class="text-body-secondary">влизания днес</small></div></div></div>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-5"><input name="searchTerm" value="@Model.SearchTerm" class="form-control" placeholder="Търси по марка, модел или никнейм" aria-label="Търсене" /></div>
    <div class="col-md-4">
        <select name="filterUser" class="form-select" aria-label="Потребител">
            <option value="">— Всички потребители —</option>
            @foreach (var u in Model.AllUsers)
            {
                <option value="@u.Id" selected="@(Model.FilterUser == u.Id)">@u.Nickname (@u.Email)</option>
            }
        </select>
    </div>
    <div class="col-md-3 d-flex gap-2">
        <button class="btn btn-primary flex-grow-1"><i class="bi bi-search me-1"></i>Филтрирай</button>
        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-x-lg"></i></a>
    </div>
</form>

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-blue"><tr><th>Автомобил</th><th>Година</th><th class="d-none d-md-table-cell">Пробег</th><th>Оценка</th><th>Потребител</th><th class="d-none d-lg-table-cell">Дата</th><th class="text-end">Действия</th></tr></thead>
            <tbody>
                @foreach (var e in Model.Entries)
                {
                    <tr>
                        <td><a asp-controller="Cars" asp-action="Details" asp-route-id="@e.Id" class="fw-semibold text-decoration-none">@e.CarModel?.CarBrand?.Name @e.CarModel?.Name</a><div class="small text-body-secondary">@e.CarEngine?.Name</div></td>
                        <td>@e.Year</td>
                        <td class="d-none d-md-table-cell">@e.Mileage.ToString("N0") км</td>
                        <td>@e.ReliabilityRating/10</td>
                        <td>@e.User?.Nickname</td>
                        <td class="d-none d-lg-table-cell small">@e.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                        <td class="text-end text-nowrap">
                            <a asp-controller="Cars" asp-action="Edit" asp-route-id="@e.Id" class="btn btn-sm btn-outline-warning" title="Редактирай"><i class="bi bi-pencil"></i></a>
                            <form asp-action="DeleteEntry" asp-route-id="@e.Id" method="post" class="d-inline" onsubmit="return confirm('Да изтрия ли този отзив?')">
                                <button class="btn btn-sm btn-outline-danger" title="Изтрий"><i class="bi bi-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                }
                @if (!Model.Entries.Any())
                {
                    <tr><td colspan="7" class="text-center text-body-secondary py-4">Няма намерени отзиви.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
