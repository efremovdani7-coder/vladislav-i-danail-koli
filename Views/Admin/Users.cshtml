@model List<(ApplicationUser User, IList<string> Roles, int EntriesCount)>
@{
    ViewData["Title"] = "Управление на потребители";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Админ панел</a></li>
        <li class="breadcrumb-item active">Потребители</li>
    </ol>
</nav>

<h2 class="mb-4"><i class="bi bi-people me-2"></i>Потребители (@Model.Count)</h2>

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Никнейм</th>
                    <th>Имейл</th>
                    <th>Роля</th>
                    <th>Записи</th>
                    <th>Регистрация</th>
                    <th>Статус</th>
                    <th class="text-end">Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var (user, roles, count) in Model)
                {
                    <tr>
                        <td class="fw-semibold">
                            <i class="bi bi-person-circle me-2"></i>@user.Nickname
                        </td>
                        <td>@user.Email</td>
                        <td>
                            @foreach (var role in roles)
                            {
                                <span class="badge @(role == "Admin" ? "bg-danger" : "bg-primary")">@role</span>
                            }
                        </td>
                        <td>
                            <a asp-action="Index" asp-route-filterUser="@user.Id" class="text-decoration-none">
                                @count записа
                            </a>
                        </td>
                        <td><small>@user.RegisteredAt.ToString("dd.MM.yyyy")</small></td>
                        @{ var isBlocked = user.LockoutEnd.HasValue && user.LockoutEnd.Value > DateTimeOffset.UtcNow; }
                        <td>
                            @if (isBlocked)
                            {
                                <span class="badge bg-secondary"><i class="bi bi-slash-circle me-1"></i>Блокиран</span>
                            }
                            else
                            {
                                <span class="badge bg-success">Активен</span>
                            }
                        </td>
                        <td class="text-end text-nowrap">
                            @if (!roles.Contains("Admin"))
                            {
                                @if (isBlocked)
                                {
                                    <form asp-action="UnblockUser" asp-route-id="@user.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button class="btn btn-outline-success btn-sm">
                                            <i class="bi bi-unlock me-1"></i>Отблокирай
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <form asp-action="BlockUser" asp-route-id="@user.Id" method="post" class="d-inline"
                                          onsubmit="return confirm('Да блокирам ли @user.Nickname? Няма да може да влиза в профила си.')">
                                        @Html.AntiForgeryToken()
                                        <button class="btn btn-outline-secondary btn-sm">
                                            <i class="bi bi-slash-circle me-1"></i>Блокирай
                                        </button>
                                    </form>
                                }
                                <form asp-action="DeleteUser" asp-route-id="@user.Id" method="post" class="d-inline"
                                      onsubmit="return confirm('Сигурни ли сте? Всички записи на потребителя ще бъдат изтрити!')">
                                    @Html.AntiForgeryToken()
                                    <button class="btn btn-outline-danger btn-sm">
                                        <i class="bi bi-trash me-1"></i>Изтрий
                                    </button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
