@model List<AdminUserRow>
@{
    ViewData["Title"] = "Админ — потребители";
}

<partial name="_AdminNav" />

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-blue">
                <tr><th>Никнейм</th><th class="d-none d-md-table-cell">Имейл</th><th>Роля</th><th class="text-center">Отзиви</th><th class="d-none d-lg-table-cell">Последно влизане</th><th>Статус</th><th class="text-end">Действия</th></tr>
            </thead>
            <tbody>
                @foreach (var row in Model)
                {
                    var u = row.User;
                    var isAdmin = row.Roles.Contains("Admin");
                    <tr>
                        <td class="fw-semibold"><i class="bi bi-person-circle me-1 text-primary"></i>@u.Nickname @if (u.IsTestAccount) { <span class="badge text-bg-secondary">тест</span> }</td>
                        <td class="d-none d-md-table-cell">@u.Email</td>
                        <td>@foreach (var r in row.Roles) { <span class="badge @(r == "Admin" ? "bg-danger" : "bg-primary") me-1">@(r == "Admin" ? "Админ" : "Потребител")</span> }</td>
                        <td class="text-center"><a asp-action="Index" asp-route-filterUser="@u.Id">@row.EntriesCount</a></td>
                        <td class="d-none d-lg-table-cell small">@(row.LastLogin?.ToLocalTime().ToString("dd.MM.yyyy HH:mm") ?? "—")</td>
                        <td>
                            @if (row.IsBlocked) { <span class="badge bg-secondary"><i class="bi bi-slash-circle me-1"></i>Блокиран</span> }
                            else { <span class="badge bg-success">Активен</span> }
                        </td>
                        <td class="text-end text-nowrap">
                            <a asp-action="Logins" asp-route-search="@u.Email" class="btn btn-sm btn-outline-primary" title="История на влизанията"><i class="bi bi-clock-history"></i></a>
                            @if (!isAdmin)
                            {
                                if (row.IsBlocked)
                                {
                                    <form asp-action="UnblockUser" asp-route-id="@u.Id" method="post" class="d-inline">
                                        <button class="btn btn-sm btn-outline-success" title="Отблокирай"><i class="bi bi-unlock"></i></button>
                                    </form>
                                }
                                else
                                {
                                    <form asp-action="BlockUser" asp-route-id="@u.Id" method="post" class="d-inline" onsubmit="return confirm('Да блокирам ли @u.Nickname? Няма да може да влиза в профила си.')">
                                        <button class="btn btn-sm btn-outline-secondary" title="Блокирай"><i class="bi bi-slash-circle"></i></button>
                                    </form>
                                }
                                <form asp-action="DeleteUser" asp-route-id="@u.Id" method="post" class="d-inline" onsubmit="return confirm('Да изтрия ли @u.Nickname и всичките му данни?')">
                                    <button class="btn btn-sm btn-outline-danger" title="Изтрий"><i class="bi bi-trash"></i></button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
